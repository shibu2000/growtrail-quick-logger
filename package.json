{
  "name": "growtrail-quick-logger",
  "productName": "Growtrail Quick Logger",
  "version": "0.2.0",
  "description": "Desktop tool that creates Growtrail tasks and logs time against them in one run.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Shibu Dhara",
    "email": "shibu.bluehorse@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:linux": "npm run build && electron-builder --linux AppImage && electron-builder --linux deb",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "homepage": "https://app.growtrail.com"
}
